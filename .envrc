# 1Password personal-account service account token, read from macOS Keychain.
# Store it with:
#   security add-generic-password -a op-service-account -s 1password-omair-inam-dotfiles -U -w
_SA_TOKEN=$(security find-generic-password \
  -a "op-service-account" \
  -s "1password-omair-inam-dotfiles" \
  -w 2>/dev/null)
if [ -n "$_SA_TOKEN" ]; then
  export OP_SERVICE_ACCOUNT_TOKEN="$_SA_TOKEN"
fi
unset _SA_TOKEN

# GitHub PAT for non-interactive `gh` (scripts, agents) — read from 1Password
# with the service account token above, so no Touch ID prompt. Interactive
# `gh` still routes through the 1Password plugin alias.
: "${GH_TOKEN_OP_REF:=op://Claude Code/op-gh-cli-omair-inam/token}"

if [ -n "$OP_SERVICE_ACCOUNT_TOKEN" ] && command -v op >/dev/null 2>&1; then
  _gh=$(op read "$GH_TOKEN_OP_REF" 2>/dev/null || true)
  if [ -n "$_gh" ]; then
    export GH_TOKEN="$_gh"
  else
    echo "direnv: op read failed for GH_TOKEN_OP_REF=$GH_TOKEN_OP_REF" >&2
    echo "direnv: check the 'Claude Code' vault has 'op-gh-cli-omair-inam'" >&2
    echo "direnv: and the service account was granted read access to it" >&2
  fi
  unset _gh
fi

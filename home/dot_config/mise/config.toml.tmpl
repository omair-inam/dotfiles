{{- /* Unified tool management via mise */ -}}
{{- /* See docs/plans/2026-03-07-unified-tool-installer-design.md */ -}}

[tools]
# Node runtime (required by npm backend)
node = "lts"

# Python CLI tools (pipx backend uses uv when available)
"pipx:google-adk" = "latest"
"pipx:showboat" = "latest"
"pipx:rodney" = "latest"
"pipx:claude-swap" = "latest"

# Claude Code status line renderer (~/.claude/settings.json statusLine)
"npm:ccstatusline" = "latest"

# Python runtime
python = "3.13"

{{- if .work_device }}
# Work tools
"npm:@arizeai/phoenix-cli" = "latest"
java = ["temurin-24", "temurin-21"]
terraform = "latest"
"npm:lavish-axi" = "latest"
"pipx:google-agents-cli" = "latest"
"github:braintrustdata/bt" = "latest"
{{ end }}

[settings]
trusted_config_paths = ["."]

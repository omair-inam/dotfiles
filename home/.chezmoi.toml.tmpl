{{/* boolean feature tags */}}
{{- $personal_device := false -}}{{/* true if this machine should have personal setup */}}
{{- $work_device := false -}}{{/* true if this machine should have work setup */}}
{{- "" -}}

{{- $personal_device = promptBoolOnce . "personal_device" "Is this a personal device" -}}
{{- $work_device = promptBoolOnce . "work_device" "Is this a work device" -}}
{{- $email := promptStringOnce . "email" "What is your email address?" -}}

[data]
  personal_device = {{ $personal_device }}
  work_device = {{ $work_device }}
  email = "{{ $email }}"

[diff]
  pager = "hunk patch -"

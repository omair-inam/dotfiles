{{- if and .work_device (eq .chezmoi.os "darwin") -}}
#!/bin/bash

set -uo pipefail

if ! grep -q '_authToken=.' "$HOME/.npmrc" 2>/dev/null; then
  cat >&2 <<'MSG'

chezmoi: ~/.npmrc has no GitHub token, so ~/.m2/settings.xml has none either.
  1. Open 1Password, sign in, and enable Settings > Developer > "Integrate with 1Password CLI".
  2. Run `chezmoi apply` again.

MSG
fi
{{ end }}

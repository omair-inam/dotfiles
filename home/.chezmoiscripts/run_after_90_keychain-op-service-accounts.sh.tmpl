{{- if and (eq .chezmoi.os "darwin") .secrets.service_account_tokens -}}
#!/bin/bash
# Keeps the 1Password service-account tokens that repo .envrc files read out of
# the login Keychain in sync with 1Password. Tokens are fetched at run time
# rather than rendered into this script, so neither `chezmoi diff` nor chezmoi's
# script-state hash ever sees one.
set -uo pipefail

if ! command -v op >/dev/null 2>&1; then
  echo "chezmoi: op not installed, skipping service-account tokens" >&2
  exit 0
fi

# The ambient service account can only read its own vault, so reads of the
# personal vault must fall back to the desktop app integration.
op_personal() {
  env -u OP_SERVICE_ACCOUNT_TOKEN -u OP_ACCOUNT \
    op --account {{ .secrets.account | quote }} "$@"
}

# The failure this guards against is a half-pasted token, which looks present
# but cannot be decoded. Only an actual authentication proves the value.
token_authenticates() {
  [[ -n "$1" ]] && env -u OP_ACCOUNT OP_SERVICE_ACCOUNT_TOKEN="$1" op whoami >/dev/null 2>&1
}

read_keychain() {
  security find-generic-password -a op-service-account -s "$1" -w 2>/dev/null
}

ensure_token() {
  local service="$1" ref="$2" token

  if token_authenticates "$(read_keychain "$service")"; then
    return 0
  fi

  echo "chezmoi: refreshing Keychain item '$service' from $ref"
  token=$(op_personal read "$ref" 2>/dev/null)
  if [[ -z "$token" ]]; then
    cat >&2 <<MSG

chezmoi: could not read $ref
  1. Open 1Password, sign in, and enable
     Settings > Developer > "Integrate with 1Password CLI".
  2. Run 'chezmoi apply' again and approve the authorization prompt.

MSG
    return 1
  fi

  security add-generic-password -U -a op-service-account -s "$service" -w "$token" || return 1

  if ! token_authenticates "$(read_keychain "$service")"; then
    echo "chezmoi: '$service' was written but does not authenticate" >&2
    return 1
  fi
  echo "chezmoi: Keychain item '$service' is valid"
}

# A locked 1Password must not abort the rest of the apply, so a failure here
# only warns.
{{ range $service, $ref := .secrets.service_account_tokens -}}
ensure_token {{ $service | quote }} {{ $ref | quote }} || true
{{ end }}
exit 0
{{ end -}}
